# Local development
# Run: npm run dev  → http://localhost:3001

# Leave empty so /api is proxied by Vite (local) or nginx (prod on admin.banyofficial.com).
# Do NOT set this to https://banyofficial.com in prod — that causes CORS errors.
VITE_API_URL=
VITE_PUBLIC_SITE_URL=http://localhost:3000

# Production build (admin.banyofficial.com):
# VITE_API_URL=
# VITE_PUBLIC_SITE_URL=https://banyofficial.com
